{
  "apiType": "stageMode",
  "buildOption": {
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      "abiFilters": [
        "arm64-v8a"
      ]
    }
  },
  "targets": [
    {
      "name": "default",
      "runtimeOS": "HarmonyOS",
      "config": {
        "deviceType": [
          "2in1"
        ],
        "buildOption": {
          "arkOptions": {
            "obfuscation": {
              "ruleOptions": {
                "enable": false
              }
            }
          }
        }
      }
    }
  ]
}